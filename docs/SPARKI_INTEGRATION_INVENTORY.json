  "architecture": {
    "dataFlow": "bron → toestemming (connector-consent per datatype) → import (runSync/ingestBatch) → validatie → opslag (ruwe rij + samengevoegde sessie) → analyse (deterministisch; taalmodel alleen proza, privacy-gated) → visualisatie → export/verwijdering",
    "tokenStorage": {
      "table": "connector_connections",
      "encryptedAtApplicationLevel": false,
      "sentToClient": false
    },
    "logging": "pino; authorization/cookie geredigeerd",
    "rateLimiting": false,
    "retries": "frontend TanStack Query; geen server-side retry-queue",
    "dedupe": "sport + 5-min startbucket + buurvenster + tolerantie; veld-merge via MERGEABLE_FIELDS",
    "conflictResolution": "echt > handmatig > geschat; handmatige override blijft",
    "disconnect": "disconnect (lokaal) en revoke (ook bij provider) per connector",
    "deletion": "DELETE-routes per entiteit; ON DELETE CASCADE op clerk_id; deleteRequestedAt-vlag zonder uitvoerende flow",
    "scheduledJobs": [
      "job:health (dagelijks)",
      "job:goal-review (maandelijks)",
      "job:reminders (dagelijks)",
      "nachtelijke kennis-/nieuwsscan"
    ]
  },
