# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Caches — never needed at runtime.
.cache
.pythonlibs

# Test bundles (rebuilt on demand by test workflows, ~1.3 GB).
artifacts/api-server/dist-tests

# Export archives & agent-side assets — not part of the running app.
exports
export
attached_assets
screenshots
test-artifacts
artifacts/product-governor
.migration-backup
bewijsarchief
