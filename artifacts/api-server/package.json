{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && export DEV_AUTH_BYPASS=true && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "scan:knowledge": "pnpm run build && node --enable-source-maps ./dist/jobs/knowledge-scan.mjs",
    "test:smoke": "pnpm run build && node --enable-source-maps ./dist/tests/smoke.mjs",
    "test:account": "pnpm run build && node --enable-source-maps ./dist/tests/account.mjs",
    "test:data-hub": "pnpm run build && node --enable-source-maps ./dist/tests/data-hub.mjs",
    "test:memory-graph": "pnpm run build && node --enable-source-maps ./dist/tests/memory-graph.mjs",
    "test:context-memory": "pnpm run build && node --enable-source-maps ./dist/tests/context-memory.mjs",
    "test:voice": "pnpm run build && node --enable-source-maps ./dist/tests/voice.mjs",
    "test:onboarding-v2": "pnpm run build && node --enable-source-maps ./dist/tests/onboarding-v2.mjs",
    "test:onboarding-personas": "pnpm run build && node --enable-source-maps ./dist/tests/onboarding-personas.mjs",
    "test:material": "pnpm run build && node --enable-source-maps ./dist/tests/material.mjs",
    "test:material-nudge": "pnpm run build && node --enable-source-maps ./dist/tests/material-nudge.mjs",
    "test:observation": "pnpm run build && node --enable-source-maps ./dist/tests/observation.mjs",
    "test:core-prediction": "pnpm run build && node --enable-source-maps ./dist/tests/core-prediction.mjs",
    "seed:social": "pnpm run build && node --enable-source-maps ./dist/scripts/seed-social.mjs",
    "seed:virtual-athletes": "pnpm run build && node --enable-source-maps ./dist/scripts/seed-virtual-athletes.mjs",
    "seed:preview": "pnpm run build && node --enable-source-maps ./dist/scripts/seed-preview-athletes.mjs",
    "job:health": "pnpm run build && node --enable-source-maps ./dist/jobs/health-check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.30",
    "@clerk/shared": "^4.20.0",
    "@google-cloud/storage": "^7.21.0",
    "@google/genai": "^1.44.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/feature-flags": "workspace:*",
    "@workspace/integrations-anthropic-ai": "workspace:*",
    "@workspace/integrations-gemini-ai": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^10.7.0",
    "http-proxy-middleware": "^4.1.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
